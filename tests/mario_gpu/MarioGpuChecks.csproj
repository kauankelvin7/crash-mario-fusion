<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath>../../.cache/mario-gpu/obj/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputPath>../../.cache/mario-gpu/bin/</OutputPath>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../integration/embedded_mario/OriginalMarioClipFrame.cs" />
    <Compile Include="../../integration/embedded_mario/OriginalMarioGpuHost.cs" />
    <Compile Include="../../integration/embedded_mario/MarioGpuState.cs" />
    <Compile Include="../../integration/embedded_mario/OriginalMarioAtlasHost.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="GpuChecks.cs" />
    <Compile Include="StateChecks.cs" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.22.0" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
